rules_version = '2';

// Deploy with: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    function isImageUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Existing profile photos (AuthService.uploadProfilePhoto).
    match /users/{uid}/profile.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid &&
        isImageUnder5MB();
    }

    // Issue photos attached on Edit Booking Details.
    match /bookings/{bookingId}/photos/{fileName} {
      function booking() {
        return firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data;
      }

      allow read: if request.auth != null &&
        (booking().customerId == request.auth.uid ||
         booking().providerId == request.auth.uid);
      allow create: if request.auth != null &&
        booking().customerId == request.auth.uid &&
        booking().status in ['pending', 'confirmed'] &&
        isImageUnder5MB();
      allow delete: if request.auth != null &&
        booking().customerId == request.auth.uid;
      allow update: if false;
    }
  }
}
