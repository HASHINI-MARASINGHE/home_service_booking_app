rules_version = '2';

// Deploy with: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    function isImageUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    function isAdmin() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Existing profile photos (AuthService.uploadProfilePhoto).
    match /users/{uid}/profile.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid &&
        isImageUnder5MB();
    }

    // Provider verification photos (ID, selfie, CV, certificates). Private:
    // only the provider who uploaded them and admins can read them. Nobody can
    // overwrite an uploaded file; a new upload gets a new name.
    match /providerDocs/{uid}/{fileName} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    // Issue photos attached on Edit Booking Details.
    match /bookings/{bookingId}/photos/{fileName} {
      function booking() {
        return firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data;
      }

      allow read: if request.auth != null &&
        (booking().customerId == request.auth.uid ||
         booking().providerId == request.auth.uid);
      allow create: if request.auth != null &&
        booking().customerId == request.auth.uid &&
        booking().status in ['pending', 'confirmed'] &&
        isImageUnder5MB();
      allow delete: if request.auth != null &&
        booking().customerId == request.auth.uid;
      allow update: if false;
    }
  }
}
